{
  "name": "netsplit-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:types": "npm run build --workspace=@netsplit/shared-types",
    "build:service": "call native\\windows-service\\build.bat",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js",
    "test:ipc": "powershell -ExecutionPolicy Bypass -File test_wifi_assign.ps1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "typescript": "^5.4.0"
  }
}
